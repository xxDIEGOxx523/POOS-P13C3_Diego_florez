# Seleccione un unico motor por ejecucion: mysql o sqlite
DB_BACKEND=mysql

# Configuracion usada solo cuando DB_BACKEND=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecotech_db

# Usado solo cuando DB_BACKEND=sqlite (ruta relativa a la raiz del proyecto o absoluta)
SQLITE_PATH=ecotech.db
